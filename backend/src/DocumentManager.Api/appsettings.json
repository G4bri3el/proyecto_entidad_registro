{
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\mssqllocaldb;Database=DocumentManagerDev;Trusted_Connection=True;MultipleActiveResultSets=true;TrustServerCertificate=True"
  },
  "Jwt": {
    "Issuer": "DocumentManager",
    "Audience": "DocumentManagerFrontend",
    "SigningKey": "",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 14,
    "TwoFactorTokenMinutes": 5
  },
  "FileUpload": {
    "MaxFileSizeMb": 25,
    "AllowedExtensions": [ ".pdf", ".jpg", ".jpeg", ".png" ],
    "AllowedMimeTypes": [ "application/pdf", "image/jpeg", "image/png" ]
  },
  "Storage": {
    "Provider": "Local",
    "Local": {
      "BasePath": "../../storage"
    }
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173" ]
  },
  "RateLimiting": {
    "AuthPermitLimit": 8,
    "AuthWindowSeconds": 60,
    "RefreshPermitLimit": 20,
    "RefreshWindowSeconds": 60
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning"
      }
    }
  }
}
