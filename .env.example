# Frontend
VITE_API_BASE_URL=https://localhost:7043/api

# Backend secrets should be configured with dotnet user-secrets or environment variables.
# Examples:
# Jwt__SigningKey=replace-with-a-random-64-character-local-development-secret
# DevelopmentSeed__AdminEmail=admin@example.local
# DevelopmentSeed__AdminPassword=replace-with-a-strong-temporary-password
# Database__Provider=PostgreSQL
# ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=entidad_registro;Username=postgres;Password=replace-with-your-local-password
# DOCUMENTMANAGER_DATABASE_PROVIDER=PostgreSQL
# DOCUMENTMANAGER_CONNECTION_STRING=Host=localhost;Port=5432;Database=entidad_registro;Username=postgres;Password=replace-with-your-local-password